@using MyFirstMVCApp.Dto
@model EmployeeDto

@{
    ViewData["Title"] = "Update Employee";
}

<div class="form-page">
    <a asp-controller="Dashboard" asp-action="Index"
       class="back-link">← Back to employees</a>

    <div class="form-card mt-3">
        <div class="form-card-heading">
            <div class="form-heading-icon">✎</div>
            <span class="eyebrow">EMPLOYEE MANAGEMENT</span>
            <h1 class="page-title">Update Employee</h1>
            <p class="text-secondary mb-0">
                Update the details and save your changes.
            </p>
        </div>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-warning" role="alert">
                @ViewBag.Message
            </div>
        }

        <form asp-controller="Dashboard"
              asp-action="UpdateEmployeeDetail"
              method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger small mb-3"></div>

            <input asp-for="Id" type="hidden" />

            <div class="mb-3">
                <label asp-for="EmployeeName" class="form-label">
                    Employee Name
                </label>
                <input asp-for="EmployeeName"
                       class="form-control app-input" />
                <span asp-validation-for="EmployeeName"
                      class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">
                    Email Address
                </label>
                <input asp-for="Email"
                       type="email"
                       class="form-control app-input" />
                <span asp-validation-for="Email"
                      class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Department" class="form-label">
                    Department
                </label>
                <input asp-for="Department"
                       class="form-control app-input" />
                <span asp-validation-for="Department"
                      class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Designation" class="form-label">
                    Designation
                </label>
                <input asp-for="Designation"
                       class="form-control app-input" />
                <span asp-validation-for="Designation"
                      class="text-danger small"></span>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-2">
                <button type="submit"
                        class="btn btn-primary app-primary-btn flex-grow-1">
                    Save Changes
                </button>
                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="btn btn-light app-cancel-btn">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}