 @using MyFirstMVCApp.Dto
@model List<EmployeeDto>

@{
    ViewData["Title"] = "Employee Dashboard";

    var employees = Model ?? new List<EmployeeDto>();
    var totalEmployees = employees.Count;
    var totalDepartments = employees
        .Where(e => !string.IsNullOrWhiteSpace(e.Department))
        .Select(e => e.Department)
        .Distinct()
        .Count();
    var totalDesignations = employees
        .Where(e => !string.IsNullOrWhiteSpace(e.Designation))
        .Select(e => e.Designation)
        .Distinct()
        .Count();
}

<style>
    .dashboard-page {
        background: #f5f7fb;
        min-height: 100vh;
        padding: 30px 0;
    }

    .dashboard-header {
        background: linear-gradient(135deg, #1e3a8a, #2563eb);
        color: white;
        border-radius: 18px;
        padding: 30px;
        margin-bottom: 25px;
        box-shadow: 0 10px 25px rgba(37, 99, 235, 0.15);
    }

    .dashboard-header h1 {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .dashboard-header p {
        margin-bottom: 0;
        color: #dbeafe;
    }

    .add-employee-btn {
        background: white;
        color: #1d4ed8;
        border: none;
        padding: 12px 18px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
    }

    .add-employee-btn:hover {
        background: #eff6ff;
        color: #1e40af;
    }

    .stat-card {
        background: white;
        border: 1px solid #e8edf5;
        border-radius: 15px;
        padding: 22px;
        height: 100%;
        box-shadow: 0 4px 15px rgba(15, 23, 42, 0.04);
    }

    .stat-label {
        color: #64748b;
        font-size: 14px;
        margin-bottom: 8px;
    }

    .stat-number {
        font-size: 30px;
        font-weight: 700;
        color: #172554;
        margin-bottom: 0;
    }

    .stat-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        border-radius: 13px;
        font-size: 22px;
    }

    .icon-blue {
        background: #dbeafe;
    }

    .icon-green {
        background: #dcfce7;
    }

    .icon-purple {
        background: #f3e8ff;
    }

    .employee-card {
        background: white;
        border: 1px solid #e8edf5;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(15, 23, 42, 0.04);
    }

    .employee-card-header {
        padding: 22px 24px;
        border-bottom: 1px solid #edf0f5;
    }

    .employee-card-header h4 {
        color: #172554;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .employee-search {
        max-width: 300px;
        border: 1px solid #dbe2ea;
        border-radius: 10px;
        padding: 10px 13px;
    }

    .employee-table {
        margin-bottom: 0;
        vertical-align: middle;
    }

    .employee-table thead th {
        background: #f8fafc;
        color: #64748b;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: .5px;
        padding: 16px;
        border-bottom: 1px solid #e8edf5;
        white-space: nowrap;
    }

    .employee-table tbody td {
        padding: 16px;
        border-color: #edf0f5;
        color: #334155;
    }

    .employee-table tbody tr:hover {
        background: #f8fbff;
    }

    .employee-avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: #dbeafe;
        color: #1d4ed8;
        font-weight: 700;
        margin-right: 10px;
        flex-shrink: 0;
    }

    .department-badge {
        display: inline-block;
        background: #eff6ff;
        color: #1d4ed8;
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
    }

    .designation-text {
        background: #f1f5f9;
        color: #475569;
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

    .action-btn {
        border-radius: 8px;
        padding: 7px 11px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        margin: 2px;
    }

    .edit-btn {
        background: #eff6ff;
        color: #1d4ed8;
    }

    .edit-btn:hover {
        background: #dbeafe;
        color: #1e40af;
    }

    .delete-btn {
        background: #fef2f2;
        color: #dc2626;
    }

    .delete-btn:hover {
        background: #fee2e2;
        color: #b91c1c;
    }

    .empty-state {
        padding: 55px 20px !important;
        text-align: center;
        color: #64748b !important;
    }

    @@media (max-width: 768px) {
        .dashboard-header {
            padding: 22px;
        }

        .dashboard-header h1 {
            font-size: 24px;
        }

        .employee-card-header {
            padding: 18px;
        }

        .employee-search {
            max-width: 100%;
            width: 100%;
        }
    }
</style>

<div class="dashboard-page">
    <div class="container">

        <!-- Dashboard Welcome Header -->
        <div class="dashboard-header">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <h1>Employee Dashboard</h1>
                    <p>Manage your employees and keep your team organized.</p>
                </div>

                <a class="add-employee-btn"
                   asp-controller="Dashboard"
                   asp-action="RedirectToEmployeeForm">
                    + Add Employee
                </a>
            </div>
        </div>

        <!-- Statistics Cards -->
        <div class="row g-3 mb-4">

            <div class="col-12 col-md-4">
                <div class="stat-card">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="stat-label">Total Employees</p>
                            <p class="stat-number">@totalEmployees</p>
                        </div>
                        <div class="stat-icon icon-blue">👥</div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="stat-card">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="stat-label">Departments</p>
                            <p class="stat-number">@totalDepartments</p>
                        </div>
                        <div class="stat-icon icon-green">🏢</div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="stat-card">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="stat-label">Designations</p>
                            <p class="stat-number">@totalDesignations</p>
                        </div>
                        <div class="stat-icon icon-purple">💼</div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Employee Table -->
        <div class="employee-card">

            <div class="employee-card-header">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        <h4>Employee Directory</h4>
                        <small class="text-muted">View and manage employee records</small>
                    </div>

                    <input type="search"
                           id="employeeSearch"
                           class="form-control employee-search"
                           placeholder="Search employees..." 
                           aria-label="Search employees" />
                </div>
            </div>

            <div class="table-responsive">
                <table class="table employee-table" id="employeeTable">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Department</th>
                            <th>Email Address</th>
                            <th>Designation</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (employees.Count > 0)
                        {
                            foreach (var employee in employees)
                            {
                                var initial = !string.IsNullOrWhiteSpace(employee.EmployeeName)
                                    ? employee.EmployeeName.Trim().Substring(0, 1).ToUpper()
                                    : "?";

                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <span class="employee-avatar">@initial</span>
                                            <span class="fw-semibold">
                                                @(employee.EmployeeName ?? "Unnamed Employee")
                                            </span>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="department-badge">
                                            @(employee.Department ?? "Not assigned")
                                        </span>
                                    </td>

                                    <td>
                                        @(employee.Email ?? "No email")
                                    </td>

                                    <td>
                                        <span class="designation-text">
                                            @(employee.Designation ?? "Not specified")
                                        </span>
                                    </td>

                                    <td class="text-center">
                                        <a class="action-btn edit-btn"
                                           asp-controller="Dashboard"
                                           asp-action="UpdateEmployee"
                                           asp-route-id="@employee.Id">
                                            ✏ Edit
                                        </a>

                                        <a class="action-btn delete-btn"
                                           asp-controller="Dashboard"
                                           asp-action="DeleteEmployee"
                                           asp-route-id="@employee.Id"
                                           onclick="return confirm('Are you sure you want to delete this employee?');">
                                            🗑 Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="empty-state">
                                    <div style="font-size: 38px;">👥</div>
                                    <h5 class="mt-3">No employees found</h5>
                                    <p>Add your first employee to get started.</p>

                                    <a class="btn btn-primary mt-2"
                                       asp-controller="Dashboard"
                                       asp-action="RedirectToEmployeeForm">
                                        + Add Employee
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center p-3 border-top">
                <small class="text-muted">
                    Total records: <strong>@totalEmployees</strong>
                </small>
                <small class="text-muted">Employee Management System</small>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("employeeSearch");
            const table = document.getElementById("employeeTable");

            if (!searchInput || !table) return;

            searchInput.addEventListener("input", function () {
                const searchText = this.value.toLowerCase().trim();
                const rows = table.querySelectorAll("tbody tr");

                rows.forEach(function (row) {
                    const rowText = row.innerText.toLowerCase();
                    row.style.display = rowText.includes(searchText) ? "" : "none";
                });
            });
        });
    </script>
}