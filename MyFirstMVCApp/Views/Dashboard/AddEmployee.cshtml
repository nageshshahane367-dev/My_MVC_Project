
@using MyFirstMVCApp.Dto
@model EmployeeDto

@{
    ViewData["Title"] = "Add Employee";
}

<div class="form-page">
    <a asp-controller="Dashboard"
       asp-action="Index"
       class="back-link">← Back to employees</a>

    <div class="form-card mt-3">
        <div class="form-card-heading">
            <div class="form-heading-icon">+</div>
            <span class="eyebrow">EMPLOYEE MANAGEMENT</span>
            <h1 class="page-title">Add New Employee</h1>
            <p class="text-secondary mb-0">
                Enter the employee's information below.
            </p>
        </div>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-warning" role="alert">
                @ViewBag.Message
            </div>
        }

        <form asp-controller="Dashboard"
              asp-action="AddEmployeeDetail"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="EmployeeName" class="form-label">
                    Employee Name
                </label>
                <input asp-for="EmployeeName"
                       class="form-control app-input"
                       placeholder="Enter full name" />
                <span asp-validation-for="EmployeeName"
                      class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">
                    Email Address
                </label>
                <input asp-for="Email"
                       type="email"
                       class="form-control app-input"
                       placeholder="name@company.com" />
                <span asp-validation-for="Email"
                      class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Department" class="form-label">
                    Department
                </label>
                <input asp-for="Department"
                       class="form-control app-input"
                       placeholder="e.g. Engineering" />
                <span asp-validation-for="Department"
                      class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Designation" class="form-label">
                    Designation
                </label>
                <input asp-for="Designation"
                       class="form-control app-input"
                       placeholder="e.g. Software Developer" />
                <span asp-validation-for="Designation"
                      class="text-danger small"></span>
            </div>

            <!-- AI Employee Description Generator -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="text-primary fs-4">✦</span>
                        <h5 class="mb-0">
                            AI Employee Description Generator
                        </h5>
                    </div>

                    <p class="text-secondary small">
                        Generate a professional job description based
                        on the department and designation above.
                    </p>

                    <button type="button"
                            id="generateDescriptionBtn"
                            class="btn btn-primary mb-3">
                        <span id="generateBtnText">
                            ✦ Generate with AI
                        </span>
                    </button>

                    <div id="aiError"
                         class="alert alert-danger d-none"
                         role="alert"></div>

                    <label for="generatedDescription"
                           class="form-label fw-semibold">
                        Generated Description
                    </label>

                    <textarea id="generatedDescription"
                              class="form-control app-input"
                              rows="5"
                              maxlength="2000"
                              placeholder="Your AI-generated description will appear here..."></textarea>

                    <div class="form-text">
                        Review and edit the generated text.
                        This preview is not saved to the database.
                    </div>
                </div>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-2">
                <button type="submit"
                        class="btn btn-primary app-primary-btn flex-grow-1">
                    Save Employee
                </button>

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="btn btn-light app-cancel-btn">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const button = document.getElementById(
                "generateDescriptionBtn");

            const buttonText = document.getElementById(
                "generateBtnText");

            const descriptionBox = document.getElementById(
                "generatedDescription");

            const errorBox = document.getElementById("aiError");

            button.addEventListener("click", async function () {
                const departmentInput =
                    document.getElementById("Department");

                const designationInput =
                    document.getElementById("Designation");

                const department = departmentInput?.value.trim();
                const designation = designationInput?.value.trim();

                if (!department || !designation) {
                    errorBox.textContent =
                        "Please enter Department and Designation first.";

                    errorBox.classList.remove("d-none");
                    return;
                }

                const token = document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                )?.value;

                if (!token) {
                    errorBox.textContent =
                        "Security token not found. Refresh the page and try again.";

                    errorBox.classList.remove("d-none");
                    return;
                }

                button.disabled = true;
                buttonText.textContent = "Generating...";
                errorBox.classList.add("d-none");

                try {
                    const response = await fetch(
                        '@Url.Action("GenerateEmployeeDescription", "Dashboard")',
                        {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                                "RequestVerificationToken": token
                            },
                            body: JSON.stringify({
                                department: department,
                                designation: designation
                            })
                        }
                    );

                    const data = await response.json();

                    if (!response.ok) {
                        throw new Error(
                            data.error ||
                            "Could not generate the description."
                        );
                    }

                    descriptionBox.value = data.description || "";
                }
                catch (error) {
                    errorBox.textContent =
                        error.message ||
                        "Something went wrong. Please try again.";

                    errorBox.classList.remove("d-none");
                }
                finally {
                    button.disabled = false;
                    buttonText.textContent = "✦ Generate with AI";
                }
            });
        });
    </script>
}
