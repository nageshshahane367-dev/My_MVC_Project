
@model IEnumerable<MyFirstMVCApp.Models.LeaveRequest>
@using MyFirstMVCApp.Models

@{
    ViewData["Title"] = "Leave Dashboard";

    var requests = Model.ToList();

    var balances = ViewBag.LeaveBalances as IEnumerable<LeaveBalance>
                   ?? Enumerable.Empty<LeaveBalance>();

    int pendingCount = requests.Count(r => r.Status == "Pending");
    int approvedCount = requests.Count(r => r.Status == "Approved");
    int rejectedCount = requests.Count(r => r.Status == "Rejected");
}

<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-1">Leave Management</h1>
            <p class="text-secondary mb-0">
                Manage your leave requests and balances.
            </p>
        </div>

        <a asp-controller="Leave" asp-action="Apply"
           class="btn btn-primary rounded-3 px-4">
            <i class="bi bi-plus-circle me-2"></i>Apply for Leave
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @success
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-5">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="text-secondary mb-2">
                        <i class="bi bi-hourglass-split me-2"></i>Pending
                    </div>
                    <h2 class="fw-bold mb-0">@pendingCount</h2>
                    <small class="text-secondary">Awaiting review</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="text-success mb-2">
                        <i class="bi bi-check-circle me-2"></i>Approved
                    </div>
                    <h2 class="fw-bold mb-0">@approvedCount</h2>
                    <small class="text-secondary">Approved requests</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="text-danger mb-2">
                        <i class="bi bi-x-circle me-2"></i>Rejected
                    </div>
                    <h2 class="fw-bold mb-0">@rejectedCount</h2>
                    <small class="text-secondary">Rejected requests</small>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-1">My Leave Balance</h4>
            <p class="text-secondary mb-4">
                Leave allowances for @ViewBag.CurrentYear
            </p>

            @if (!balances.Any())
            {
                <div class="alert alert-info mb-0">
                    No leave balances have been configured for this year.
                    Please contact HR.
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var balance in balances)
                    {
                        var percentage = balance.AnnualAllowance > 0
                            ? Math.Clamp(
                                (double)balance.UsedDays /
                                balance.AnnualAllowance * 100, 0, 100)
                            : 0;

                        <div class="col-12 col-md-4">
                            <div class="border rounded-3 p-3 h-100">
                                <h6 class="fw-bold">@balance.LeaveType Leave</h6>

                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-secondary">Remaining</span>
                                    <strong>@balance.RemainingDays days</strong>
                                </div>

                                <div class="progress mb-2" style="height: 8px;">
                                    <div class="progress-bar bg-primary"
                                         role="progressbar"
                                         style="width: @percentage.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"
                                         aria-valuenow="@percentage"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                    </div>
                                </div>

                                <small class="text-secondary">
                                    @balance.UsedDays used of
                                    @balance.AnnualAllowance days
                                </small>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="p-4 border-bottom">
                <h4 class="fw-bold mb-1">My Leave Requests</h4>
                <p class="text-secondary mb-0">
                    Track your applications and review decisions.
                </p>
            </div>

            @if (!requests.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar2-week text-secondary"
                       style="font-size: 3rem;"></i>
                    <h5 class="mt-3">No leave requests yet</h5>
                    <p class="text-secondary">
                        Submit your first leave request to get started.
                    </p>
                    <a asp-action="Apply" class="btn btn-primary">
                        Apply for Leave
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Leave Type</th>
                                <th>Dates</th>
                                <th>Days</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in requests)
                            {
                                var badgeClass = request.Status switch
                                {
                                    "Approved" => "bg-success-subtle text-success",
                                    "Rejected" => "bg-danger-subtle text-danger",
                                    "Cancelled" => "bg-secondary-subtle text-secondary",
                                    _ => "bg-warning-subtle text-warning-emphasis"
                                };

                                <tr>
                                    <td class="ps-4 fw-semibold">
                                        @request.LeaveType
                                    </td>
                                    <td>
                                        <div>@request.StartDate.ToString("dd MMM yyyy")</div>
                                        <small class="text-secondary">
                                            to @request.EndDate.ToString("dd MMM yyyy")
                                        </small>
                                    </td>
                                    <td>@request.TotalDays</td>
                                    <td>
                                        <span class="badge rounded-pill @badgeClass">
                                            @request.Status
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Details"
                                           asp-route-id="@request.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Details
                                        </a>

                                        @if (request.Status == "Pending")
                                        {
                                            <form asp-action="Cancel"
                                                  asp-route-id="@request.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Cancel this leave request?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Cancel
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="Dashboard" asp-action="Index"
           class="btn btn-light border rounded-3">
            <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
        </a>
    </div>
</div>
