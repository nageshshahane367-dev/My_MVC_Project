
@model IEnumerable<MyFirstMVCApp.Models.LeaveRequest>

@{
    ViewData["Title"] = "Manage Leave Requests";

    var requests = Model.ToList();
    var pendingCount = requests.Count(r => r.Status == "Pending");
}

<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-1">Manage Leave Requests</h1>
            <p class="text-secondary mb-0">
                Review applications and record your decisions.
            </p>
        </div>

        <span class="badge rounded-pill bg-warning-subtle
                     text-warning-emphasis fs-6 px-3 py-2">
            @pendingCount pending
        </span>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @success
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @error
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            @if (!requests.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-clipboard-check text-secondary"
                       style="font-size: 3rem;"></i>
                    <h5 class="mt-3">No leave requests found</h5>
                    <p class="text-secondary mb-0">
                        Employee applications will appear here.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Employee</th>
                                <th>Leave</th>
                                <th>Dates</th>
                                <th>Days</th>
                                <th>Status</th>
                                <th class="pe-4" style="min-width: 300px;">
                                    Review
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in requests)
                            {
                                var badgeClass = request.Status switch
                                {
                                    "Approved" => "bg-success-subtle text-success",
                                    "Rejected" => "bg-danger-subtle text-danger",
                                    "Cancelled" => "bg-secondary-subtle text-secondary",
                                    _ => "bg-warning-subtle text-warning-emphasis"
                                };

                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-semibold">
                                            @request.Employee.EmployeeName
                                        </div>
                                        <small class="text-secondary">
                                            @request.Employee.Email
                                        </small>
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @request.LeaveType
                                        </div>
                                        <small class="text-secondary">
                                            @request.AppliedOnUtc.ToString("dd MMM yyyy")
                                        </small>
                                    </td>

                                    <td>
                                        <div>@request.StartDate.ToString("dd MMM yyyy")</div>
                                        <small class="text-secondary">
                                            to @request.EndDate.ToString("dd MMM yyyy")
                                        </small>
                                    </td>

                                    <td>@request.TotalDays</td>

                                    <td>
                                        <span class="badge rounded-pill @badgeClass">
                                            @request.Status
                                        </span>
                                    </td>

                                    <td class="pe-4">
                                        <a asp-action="Details"
                                           asp-route-id="@request.Id"
                                           class="btn btn-sm btn-outline-primary mb-2">
                                            View Details
                                        </a>

                                        @if (request.Status == "Pending")
                                        {
                                            <form asp-action="Approve"
                                                  asp-route-id="@request.Id"
                                                  method="post"
                                                  class="mb-3">
                                                @Html.AntiForgeryToken()

                                                <label class="form-label small fw-semibold">
                                                    Approval comments (optional)
                                                </label>

                                                <textarea name="reviewComments"
                                                          class="form-control form-control-sm mb-2"
                                                          rows="2"
                                                          maxlength="1000"
                                                          placeholder="Add a comment..."></textarea>

                                                <button type="submit"
                                                        class="btn btn-sm btn-success w-100"
                                                        onclick="return confirm('Approve this leave request?');">
                                                    <i class="bi bi-check-circle me-1"></i>
                                                    Approve
                                                </button>
                                            </form>

                                            <form asp-action="Reject"
                                                  asp-route-id="@request.Id"
                                                  method="post">
                                                @Html.AntiForgeryToken()

                                                <label class="form-label small fw-semibold">
                                                    Rejection reason (required)
                                                </label>

                                                <textarea name="reviewComments"
                                                          class="form-control form-control-sm mb-2"
                                                          rows="2"
                                                          maxlength="1000"
                                                          minlength="5"
                                                          required
                                                          placeholder="Explain why the request is rejected..."></textarea>

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger w-100"
                                                        onclick="return confirm('Reject this leave request?');">
                                                    <i class="bi bi-x-circle me-1"></i>
                                                    Reject
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <div class="small text-secondary mt-2">
                                                <strong>Reviewer:</strong>
                                                @(request.ReviewedByUser?.Username ?? "—")
                                            </div>

                                            <div class="small text-secondary mt-1">
                                                <strong>Comments:</strong>
                                                @(string.IsNullOrWhiteSpace(request.ReviewComments)
                                                    ? "None"
                                                    : request.ReviewComments)
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="mt-4 d-flex flex-wrap gap-2">
        <a asp-controller="Dashboard" asp-action="Index"
           class="btn btn-light border rounded-3">
            <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
        </a>

        <a asp-action="Index"
           class="btn btn-outline-primary rounded-3">
            Employee Leave Dashboard
        </a>
    </div>
</div>
