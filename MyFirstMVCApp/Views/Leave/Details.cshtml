
@model MyFirstMVCApp.Models.LeaveRequest

@{
    ViewData["Title"] = "Leave Request Details";

    var badgeClass = Model.Status switch
    {
        "Approved" => "bg-success-subtle text-success",
        "Rejected" => "bg-danger-subtle text-danger",
        "Cancelled" => "bg-secondary-subtle text-secondary",
        _ => "bg-warning-subtle text-warning-emphasis"
    };
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">
            <div class="d-flex flex-wrap justify-content-between
                        align-items-center gap-3 mb-4">
                <div>
                    <h1 class="fw-bold mb-1">Leave Request Details</h1>
                    <p class="text-secondary mb-0">
                        Request #@Model.Id
                    </p>
                </div>

                <span class="badge rounded-pill fs-6 px-3 py-2 @badgeClass">
                    @Model.Status
                </span>
            </div>

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">Request Information</h5>

                    <div class="row g-4">
                        <div class="col-12 col-md-6">
                            <div class="text-secondary small mb-1">Employee</div>
                            <div class="fw-semibold">@Model.Employee.EmployeeName</div>
                            <div class="text-secondary">@Model.Employee.Email</div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="text-secondary small mb-1">Department</div>
                            <div class="fw-semibold">@Model.Employee.Department</div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="text-secondary small mb-1">Leave Type</div>
                            <div class="fw-semibold">@Model.LeaveType Leave</div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="text-secondary small mb-1">Total Days</div>
                            <div class="fw-semibold">@Model.TotalDays days</div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="text-secondary small mb-1">Start Date</div>
                            <div class="fw-semibold">
                                @Model.StartDate.ToString("dd MMM yyyy")
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="text-secondary small mb-1">End Date</div>
                            <div class="fw-semibold">
                                @Model.EndDate.ToString("dd MMM yyyy")
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="text-secondary small mb-1">Reason for Leave</div>
                            <div class="border rounded-3 p-3">
                                @Model.Reason
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="text-secondary small mb-1">Applied On (UTC)</div>
                            <div>
                                @Model.AppliedOnUtc.ToString("dd MMM yyyy, hh:mm tt")
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Review Information</h5>

                    @if (Model.ReviewedOnUtc.HasValue)
                    {
                        <div class="mb-3">
                            <div class="text-secondary small mb-1">
                                Reviewed By
                            </div>

                            <div class="fw-semibold">
                                @(Model.ReviewedByUser?.Username ?? "Reviewer")
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="text-secondary small mb-1">
                                Reviewed On (UTC)
                            </div>

                            <div>
                                @Model.ReviewedOnUtc.Value.ToString(
                                    "dd MMM yyyy, hh:mm tt")
                            </div>
                        </div>

                        <div>
                            <div class="text-secondary small mb-1">
                                Review Comments
                            </div>

                            <div class="border rounded-3 p-3">
                                @(string.IsNullOrWhiteSpace(Model.ReviewComments)
                                    ? "No comments provided."
                                    : Model.ReviewComments)
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">
                            This request is awaiting review.
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Index"
                   class="btn btn-light border rounded-3">
                    <i class="bi bi-arrow-left me-1"></i>My Leave Requests
                </a>

                @if (User.IsInRole("Admin") || User.IsInRole("HR"))
                {
                    <a asp-action="Manage"
                       class="btn btn-outline-primary rounded-3">
                        <i class="bi bi-clipboard-check me-1"></i>Manage Requests
                    </a>
                }

                @if (Model.Status == "Pending" &&
                     !User.IsInRole("Admin") &&
                     !User.IsInRole("HR"))
                {
                    <form asp-action="Cancel"
                          asp-route-id="@Model.Id"
                          method="post"
                          onsubmit="return confirm('Cancel this leave request?');">
                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-danger rounded-3">
                            Cancel Request
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
