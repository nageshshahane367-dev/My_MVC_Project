 @using MyFirstMVCApp.Dto
@model UserDto

@{
    ViewData["Title"] = "Login";
}

<style>
    .login-page {
        min-height: 78vh;
        padding: 35px 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #eff6ff, #f8fafc, #e0e7ff);
        border-radius: 18px;
    }

    .login-card {
        width: 100%;
        max-width: 430px;
        background: #fff;
        border: 1px solid #e5eaf3;
        border-radius: 20px;
        padding: 36px;
        box-shadow: 0 18px 50px rgba(30, 64, 175, 0.12);
    }

    .login-logo {
        width: 64px;
        height: 64px;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 0 auto 18px;
        border-radius: 18px;
        background: linear-gradient(135deg, #1e3a8a, #3b82f6);
        color: white;
        font-size: 30px;
        font-weight: 700;
        box-shadow: 0 8px 20px rgba(37, 99, 235, 0.22);
    }

    .login-heading {
        color: #172554;
        font-weight: 750;
        text-align: center;
        margin-bottom: 8px;
    }

    .login-subtitle {
        text-align: center;
        color: #64748b;
        font-size: 14px;
        margin-bottom: 28px;
    }

    .login-label {
        color: #334155;
        font-size: 14px;
        font-weight: 650;
        margin-bottom: 8px;
    }

    .login-input {
        min-height: 48px;
        border: 1px solid #dbe2ea;
        border-radius: 10px;
        padding: 11px 14px;
    }

    .login-input:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12);
    }

    .login-submit {
        min-height: 48px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(110deg, #1e40af, #2563eb);
        color: #fff;
        font-weight: 650;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .login-submit:hover {
        color: #fff;
        transform: translateY(-1px);
        box-shadow: 0 8px 18px rgba(37, 99, 235, 0.25);
    }

    .login-register {
        text-align: center;
        color: #64748b;
        font-size: 14px;
        margin-top: 22px;
        margin-bottom: 0;
    }

    .login-register a {
        color: #1d4ed8;
        font-weight: 700;
        text-decoration: none;
    }

    .login-register a:hover {
        text-decoration: underline;
    }

    .login-message {
        border-radius: 10px;
        font-size: 14px;
    }

    @@media (max-width: 480px) {
        .login-card {
            padding: 26px 21px;
        }
    }
</style>

<!-- Public Login Navbar -->
<nav class="navbar navbar-expand-sm rounded-3 mb-4"
     style="background: linear-gradient(110deg, #14213d, #1e40af); padding: 12px 18px;">

    <div class="container-fluid px-0">

        <a class="navbar-brand text-white fw-bold d-flex align-items-center gap-2"
           asp-controller="Home"
           asp-action="Index">

            <span class="d-inline-flex align-items-center justify-content-center rounded-3"
                  style="width: 40px; height: 40px; background: rgba(255,255,255,.15);">
                ✦
            </span>

            MyFirstMVCApp
        </a>

        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-sm text-white">
                Home
            </a>

            <a asp-controller="Auth"
               asp-action="Registration"
               class="btn btn-sm btn-light fw-semibold px-3">
                Register
            </a>
        </div>

    </div>
</nav>

<!-- Login Form -->
<div class="login-page">

    <div class="login-card">

        <div class="login-logo">✦</div>

        <h2 class="login-heading">Welcome Back!</h2>

        <p class="login-subtitle">
            Sign in to access your employee dashboard.
        </p>

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success login-message" role="alert">
                @TempData["Message"]
            </div>
        }

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-danger login-message" role="alert">
                @ViewBag.Message
            </div>
        }

        <form asp-controller="Auth"
              asp-action="LoginUser"
              method="post">

            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Email" class="form-label login-label">
                    Email Address
                </label>

                <input asp-for="Email"
                       type="email"
                       class="form-control login-input"
                       placeholder="Enter your email"
                       autocomplete="username"
                       required />

                <span asp-validation-for="Email"
                      class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label login-label">
                    Password
                </label>

                <input asp-for="Password"
                       type="password"
                       class="form-control login-input"
                       placeholder="Enter your password"
                       autocomplete="current-password"
                       required />

                <span asp-validation-for="Password"
                      class="text-danger small"></span>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn login-submit">
                    Sign In &rarr;
                </button>
            </div>

        </form>

        <p class="login-register">
            New to MyFirstMVCApp?
            <a asp-controller="Auth" asp-action="Registration">
                Create an account
            </a>
        </p>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}