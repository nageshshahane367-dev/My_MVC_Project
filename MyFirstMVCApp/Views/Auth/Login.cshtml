@using MyFirstMVCApp.Dto
@model UserDto

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-brand-icon">P</div>
        <span class="eyebrow">WELCOME BACK</span>
        <h1 class="page-title">Sign in to PeopleHub</h1>
        <p class="text-secondary mb-4">
            Enter your account details to continue.
        </p>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-warning" role="alert">
                @ViewBag.Message
            </div>
        }

        <form asp-controller="Auth" asp-action="LoginUser" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">
                    Email Address
                </label>
                <input asp-for="Email"
                       type="email"
                       class="form-control app-input"
                       autocomplete="username"
                       placeholder="you@company.com" />
                <span asp-validation-for="Email"
                      class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label">
                    Password
                </label>
                <input asp-for="Password"
                       type="password"
                       class="form-control app-input"
                       autocomplete="current-password"
                       placeholder="Enter your password" />
                <span asp-validation-for="Password"
                      class="text-danger small"></span>
            </div>

            <button type="submit"
                    class="btn btn-primary app-primary-btn w-100">
                Sign In
            </button>
        </form>

        <p class="text-center small text-secondary mt-4 mb-0">
            Don't have an account?
            <a asp-controller="Auth" asp-action="Registration"
               class="auth-link">Create one</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}