
@model IEnumerable<MyFirstMVCApp.Models.Notification>

@{
    ViewData["Title"] = "Notification Center";

    var notifications = Model.ToList();
    var unreadCount = notifications.Count(n => !n.IsRead);
}

<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-1">Notification Center</h1>
            <p class="text-secondary mb-0">
                View your latest notifications and updates.
            </p>
        </div>

        @if (unreadCount > 0)
        {
            <form asp-controller="Notifications"
                  asp-action="MarkAllRead"
                  method="post">
                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-outline-primary">
                    Mark all as read
                </button>
            </form>
        }
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">

            <div class="p-4 border-bottom d-flex
                        justify-content-between align-items-center">
                <h5 class="mb-0">Your notifications</h5>

                <span class="badge rounded-pill bg-primary">
                    @unreadCount unread
                </span>
            </div>

            @if (notifications.Count == 0)
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-bell"
                           style="font-size: 2.5rem;"></i>
                    </div>

                    <h5>No notifications yet</h5>
                    <p class="text-secondary mb-0">
                        New updates will appear here.
                    </p>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var notification in notifications)
                    {
                        <div class="list-group-item p-4
                                    @(notification.IsRead
                                        ? ""
                                        : "bg-primary-subtle")">

                            <div class="d-flex gap-3">
                                <div class="text-primary pt-1">
                                    <i class="bi
                                        @(notification.IsRead
                                            ? "bi-bell"
                                            : "bi-bell-fill")"
                                       style="font-size: 1.4rem;"></i>
                                </div>

                                <div class="flex-grow-1">
                                    <div class="d-flex flex-wrap
                                                justify-content-between gap-2">
                                        <h6 class="fw-bold mb-1">
                                            @notification.Title
                                        </h6>

                                        @if (!notification.IsRead)
                                        {
                                            <span class="badge bg-primary">
                                                New
                                            </span>
                                        }
                                    </div>

                                    <p class="mb-2">
                                        @notification.Message
                                    </p>

                                    <small class="text-secondary">
                                        @notification.CreatedAtUtc.ToString(
                                            "dd MMM yyyy, hh:mm tt")
                                        UTC
                                    </small>

                                    @if (!notification.IsRead)
                                    {
                                        <div class="mt-3">
                                            <form asp-controller="Notifications"
                                                  asp-action="MarkRead"
                                                  asp-route-id="@notification.Id"
                                                  method="post">
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-primary">
                                                    Mark as read
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-light border">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Dashboard
        </a>
    </div>
</div>
