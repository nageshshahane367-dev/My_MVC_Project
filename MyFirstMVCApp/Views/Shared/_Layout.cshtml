<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - MyFirstMVCApp</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyFirstMVCApp.styles.css" asp-append-version="true" />

    <style>
        /* Main navbar */
        .app-navbar {
            background: linear-gradient(110deg, #14213d, #1e40af);
            padding: 12px 0;
            box-shadow: 0 5px 20px rgba(15, 23, 42, 0.16);
            margin-bottom: 28px;
        }

        .app-navbar .navbar-brand {
            color: #fff;
            font-size: 21px;
            font-weight: 750;
            letter-spacing: 0.3px;
            display: flex;
            align-items: center;
            gap: 11px;
            margin-right: 32px;
        }

        .app-navbar .navbar-brand:hover {
            color: #dbeafe;
        }

        .brand-logo {
            width: 42px;
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.22);
            border-radius: 13px;
            color: #fff;
            font-size: 21px;
        }

        .app-navbar .navbar-nav {
            gap: 8px;
        }

        .app-navbar .nav-link {
            color: #dbeafe;
            font-weight: 500;
            padding: 10px 16px !important;
            border-radius: 9px;
            transition: background-color 0.2s ease, color 0.2s ease;
        }

        .app-navbar .nav-link:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.12);
        }

        .app-navbar .nav-link.active {
            color: #fff;
            background: rgba(255, 255, 255, 0.17);
            font-weight: 650;
        }

        .navbar-right {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .navbar-user-label {
            color: #dbeafe;
            font-size: 13px;
        }

        .logout-btn {
            background: #fff;
            color: #1e40af;
            border: 1px solid #fff;
            border-radius: 9px;
            padding: 9px 17px;
            font-weight: 650;
            transition: all 0.2s ease;
        }

        .logout-btn:hover {
            background: #fee2e2;
            border-color: #fee2e2;
            color: #b91c1c;
            transform: translateY(-1px);
        }

        .app-navbar .navbar-toggler {
            border-color: rgba(255, 255, 255, 0.4);
            padding: 7px 10px;
        }

        .app-navbar .navbar-toggler:focus {
            box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.15);
        }

        .app-navbar .navbar-toggler-icon {
            filter: brightness(0) invert(1);
        }

        /* Footer */
        .app-footer {
            margin-top: 35px;
            padding: 20px 0;
            border-top: 1px solid #e2e8f0;
            background: #fff;
            color: #64748b;
            font-size: 14px;
        }

        .app-footer a {
            color: #1d4ed8;
            text-decoration: none;
            font-weight: 500;
        }

        .app-footer a:hover {
            text-decoration: underline;
        }

        @@media (max-width: 575.98px) {
            .app-navbar .navbar-brand {
                font-size: 18px;
                margin-right: 0;
            }

            .app-navbar .navbar-collapse {
                padding-top: 14px;
            }

            .app-navbar .navbar-nav {
                gap: 4px;
            }

            .navbar-right {
                margin-top: 12px;
                padding-top: 12px;
                border-top: 1px solid rgba(255, 255, 255, 0.18);
            }

            .logout-btn {
                width: 100%;
            }
        }
    </style>
</head>

<body>
    <header>
        @{
            var controllerName =
                ViewContext.RouteData.Values["controller"]?.ToString();

            var actionName =
                ViewContext.RouteData.Values["action"]?.ToString();

            var isAuthPage =
                controllerName == "Auth" &&
                (actionName == "Login" ||
                 actionName == "Registration");

            var isHomePage =
                controllerName == "Home" &&
                actionName == "Index";

            var isPrivacyPage =
                controllerName == "Home" &&
                actionName == "Privacy";
        }

        @if (!isAuthPage && User.Identity?.IsAuthenticated == true)
        {
            <nav class="navbar navbar-expand-sm app-navbar">
                <div class="container-fluid px-3 px-lg-4">

                    <!-- Brand -->
                    <a class="navbar-brand"
                       asp-controller="Dashboard"
                       asp-action="Index">
                        <span class="brand-logo">✦</span>
                        <span>MyFirstMVCApp</span>
                    </a>

                    <!-- Mobile menu button -->
                    <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#mainNavbar"
                            aria-controls="mainNavbar"
                            aria-expanded="false"
                            aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <!-- Navigation links -->
                    <div class="collapse navbar-collapse" id="mainNavbar">

                        <ul class="navbar-nav me-auto">

                            <li class="nav-item">
                                <a class="nav-link @(isHomePage ? "active" : "")"
                                   asp-controller="Home"
                                   asp-action="Index"
                                   aria-current="@(isHomePage ? "page" : null)">
                                    <span class="me-1">⌂</span> Home
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(isPrivacyPage ? "active" : "")"
                                   asp-controller="Home"
                                   asp-action="Privacy"
                                   aria-current="@(isPrivacyPage ? "page" : null)">
                                    <span class="me-1">ⓘ</span> Privacy
                                </a>
                            </li>

                        </ul>

                        <!-- User and logout section -->
                        <div class="navbar-right">

                            <span class="navbar-user-label">
                                Welcome, @(User.Identity?.Name ?? "User")
                            </span>

                            <form asp-controller="Auth"
                                  asp-action="Logout"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit" class="btn logout-btn">
                                    ↪ Logout
                                </button>
                            </form>

                        </div>

                    </div>
                </div>
            </nav>
        }
    </header>

    <!-- Main content -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="app-footer">
        <div class="container d-flex flex-column flex-sm-row
                    justify-content-between align-items-center gap-2">
            <span>&copy; 2026 MyFirstMVCApp. All rights reserved.</span>

            <a asp-controller="Home" asp-action="Privacy">
                Privacy Policy
            </a>
        </div>
    </footer>

    <!-- JavaScript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>