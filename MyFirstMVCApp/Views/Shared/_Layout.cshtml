<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - MyFirstMVCApp</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/MyFirstMVCApp.styles.css"
          asp-append-version="true" />

    @* Layout-specific footer and content positioning *@
    <style>
        html {
            min-height: 100%;
        }

        body.app-layout {
            min-height: 100vh;
            margin: 0;
            display: flex;
            flex-direction: column;
        }

        .app-layout > header {
            flex: 0 0 auto;
        }

        .app-layout .app-main {
            flex: 1 0 auto;
            width: 100%;
        }

        .app-layout .app-footer {
            flex-shrink: 0;
            width: 100%;
            margin-top: auto;
        }
    </style>
</head>

<body class="app-layout">

    @* Navigation bar *@
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
            <div class="container-fluid">

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-icon">M</span>
                    <span>MyFirstMVCApp</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    @* Main navigation links *@
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    Dashboard
                                </a>
                            </li>

                            @* Leave Management for authenticated users *@
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Leave"
                                   asp-action="Index">
                                    <span class="me-1">📅</span>
                                    Leave Management
                                </a>
                            </li>

                            @* Leave approval for Admin and HR *@
                            @if (User.IsInRole("Admin") ||
                                 User.IsInRole("HR"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Leave"
                                       asp-action="Manage">
                                        Manage Leave Requests
                                    </a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Notifications"
                                   asp-action="Index">
                                    Notifications
                                </a>
                            </li>
                        }
                    </ul>

                    @* Authentication controls *@
                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="navbar-text text-white me-lg-3">
                                    Welcome, @(User.Identity.Name ?? "User")
                                </span>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Auth"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-outline-light btn-sm">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-lg-2">
                                <a class="btn btn-outline-light btn-sm"
                                   asp-controller="Auth"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>

                            <li class="nav-item mt-2 mt-lg-0">
                                <a class="btn btn-light btn-sm text-primary"
                                   asp-controller="Auth"
                                   asp-action="Registration">
                                    Register
                                </a>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    @* Main content fills the remaining vertical space *@
    <main role="main" class="app-main container py-4">
        @RenderBody()
    </main>

    @* Footer stays at the bottom on short pages *@
    <footer class="app-footer">
        <div class="container d-flex flex-column flex-sm-row
                    justify-content-between align-items-center gap-2">

            <span>
                &copy; @DateTime.Now.Year MyFirstMVCApp
            </span>

            <span>
                Employee Management System
            </span>

        </div>
    </footer>

    @* JavaScript files *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>