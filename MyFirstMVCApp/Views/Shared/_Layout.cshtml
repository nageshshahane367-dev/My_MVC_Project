@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PeopleHub</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <span class="brand-icon">P</span>
                PeopleHub
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto ms-lg-4">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Admin") || User.IsInRole("HR"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Dashboard"
                                   asp-action="Index">Employees</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Dashboard"
                                   asp-action="AddEmployee">Add Employee</a>
                            </li>
                        }
                    }
                </ul>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0">
                        <div class="text-white text-lg-end">
                            <div class="small text-white-50">Signed in as</div>
                            <div class="fw-semibold">
                                @(User.Identity.Name ?? "User")
                            </div>
                            <span class="badge role-badge">
                                @(User.FindFirst(ClaimTypes.Role)?.Value ?? "User")
                            </span>
                        </div>

                        <form asp-controller="Auth"
                              asp-action="Logout"
                              method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-outline-light btn-sm">
                                <span aria-hidden="true">↪</span> Logout
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="d-flex gap-2 mt-3 mt-lg-0">
                        <a class="btn btn-outline-light btn-sm"
                           asp-controller="Auth"
                           asp-action="Login">Login</a>

                        <a class="btn btn-light btn-sm text-primary fw-semibold"
                           asp-controller="Auth"
                           asp-action="Registration">Register</a>
                    </div>
                }
            </div>
        </div>
    </nav>

    <main class="container app-main py-4 py-lg-5">
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="container d-flex flex-column flex-md-row
                    justify-content-between align-items-center gap-2">
            <span>© @DateTime.Now.Year PeopleHub</span>
            <span>Employee Management System</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>